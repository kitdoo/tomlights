# ---------------------------------------------------------------------
# TomLights — local environment.
#
# Copy to `.env` (never commit it). The backend loads `.env` itself on
# start (cmd/tomlights/main.go), and docker compose reads the same file.
# Double underscore = nested config key: MONGODB__HOSTS -> mongodb.hosts,
# APP__SMTP__HOST -> app.smtp.host (see configs/*.yaml for every option).
# ---------------------------------------------------------------------

# --- backend: runtime dirs (go-atlas appinfo) ------------------------
# Defaults are /var/lib/tomlights, /etc/tomlights, ... which need root on
# a dev machine. Point them at the repo-local, gitignored var/ instead.
# docker compose blanks these so the container uses the standard paths.
BIN_DIR=./build/bin
VAR_DIR=./var
LIB_DIR=./var/lib
ETC_DIR=./var/etc

# --- backend: listeners ----------------------------------------------
GRPC__LISTEN_ADDRESS=127.0.0.1:7779
GRPC__REFLECTION=true
GRPC__LOG_REQUESTS=true
HTTP__LISTEN_ADDRESS=127.0.0.1:9080
HTTP__LOG_REQUESTS=true

# --- backend: logger -------------------------------------------------
LOGGER__LEVEL=debug
LOGGER__OUTPUT_FORMAT=text
LOGGER__COLORIZED=true

# --- backend: node ---------------------------------------------------
NODE__ID=1

# --- backend: mongodb ------------------------------------------------
# docker compose overrides MONGODB__HOSTS to [mongo:27017] for the
# backend container; this value is for `make run` against a local mongo
# (`make mongo-up` starts one in docker on localhost:27017).
MONGODB__HOSTS=[localhost:27017]
MONGODB__DATABASE=tomlights
MONGODB__DIRECT_CONNECTION=true
MONGODB__CREDENTIALS__AUTH_MECHANISM=SCRAM-SHA-256
MONGODB__CREDENTIALS__SCRAM__AUTH_SOURCE=admin
MONGODB__CREDENTIALS__SCRAM__USERNAME=admin
MONGODB__CREDENTIALS__SCRAM__PASSWORD=change-me

# mongo container root user (docker compose only). Must equal the SCRAM
# username/password above.
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=change-me
# Host port compose publishes mongo on (127.0.0.1 only). Change it if 27017
# is already taken, and update MONGODB__HOSTS above to match for `make run`.
MONGO_PORT=27017

# --- backend: observability ------------------------------------------
OBSERVABILITY__METRICS__ENABLED=true
OBSERVABILITY__METRICS__TYPE=prometheus
OBSERVABILITY__METRICS__SERVICE_NAME=tomlights

# --- backend: email sender -------------------------------------------
# Optional. Leave all commented to boot without email. Set host/port/from
# (+ username/password if needed) to enable SMTP, or all resend fields to
# use Resend (takes precedence over SMTP when both are set).
#APP__SMTP__HOST=smtp.gmail.com
#APP__SMTP__PORT=587
#APP__SMTP__USERNAME=you@example.com
#APP__SMTP__PASSWORD=change-me
#APP__SMTP__FROM=no-reply@example.com
#APP__RESEND__API_KEY=re_xxx
#APP__RESEND__FROM=no-reply@your-verified-domain.com

# --- web (Nuxt) ------------------------------------------------------
# Used by docker compose; for `make web-dev` see web/.env.example.
WEB_PORT=3000
NUXT_GRPC_TIMEOUT_MS=15000

# --- docker compose: build/log settings ------------------------------
APP_VERSION=dev
APP_VERSION_COMMIT=local
LOG_MAX_SIZE=10m
LOG_MAX_FILE=5
